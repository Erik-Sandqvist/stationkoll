# Kopiera denna fil till `.env` och fyll i värdena från ditt Supabase-projekt
# (Project Settings -> API). `.env` ska aldrig checkas in i git.

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Lösenord som spärrar appen under demoperioden. Lämnas den tom är spärren
# avstängd. Den döljer bara gränssnittet — Supabase-nyckeln ovan ligger kvar i
# klienten, så det är inte ett skydd av datan.
VITE_DEMO_PASSWORD=

# "true" visar profilväxlaren i navbaren, så att kundprofilen (färger, namn,
# logga) kan bytas live under en demo. Lämnas den tom körs appen alltid i
# förvalsprofilen — det man vill vid en skarp kundinstallation.
VITE_BRAND_SWITCHER=
